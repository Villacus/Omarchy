      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "autoCompactWindow": 800000,
  "theme": "dark",
"hooks": {"SessionStart":[{"matcher":"*","hooks":[{"type":"command","command":"bash '/home/villacus/.claude/hooks/herdr-agent-state.sh' session","timeout":10}]}]},
  "permissions": {
    "allow": [
      "Bash(graphify *)"
    ]
  }
