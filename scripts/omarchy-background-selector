#!/bin/bash

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
state_dir="$HOME/.local/state/omarchy/current"
theme_name=$(cat "$state_dir/theme.name" 2>/dev/null)
current_background=$(readlink -f "$state_dir/background" 2>/dev/null)
engine_pid_dir="$state_dir/wallpaper-engine-pids"
engine_dir="$config_home/omarchy/backgrounds/wallpaper-engine"
CONFIG_FILE="$state_dir/wallpapers.conf"

for dep in omarchy-menu-images omarchy-menu-select omarchy-theme-bg-set hyprctl jq awk; do
  if ! command -v "$dep" >/dev/null 2>&1; then
    echo "Falta $dep; no se puede abrir el selector de fondos" >&2
    exit 1
  fi
done

stop_wallpaper_engine() {
  local monitor="$1"
  local pid_file="$engine_pid_dir/$monitor.pid"

  if [[ -f "$pid_file" ]]; then
    old_pid=$(cat "$pid_file")
    if kill -0 "$old_pid" 2>/dev/null; then
      kill "$old_pid"
      sleep 0.5
    fi
    rm -f "$pid_file"
  fi

  rm -f "$state_dir/wallpaper-engine.pid"
}

# Mostrar el selector de fondo. Solo se buscan los directorios que existen para
# no pasar una ruta vacia cuando aun no hay tema activo.
search_dirs=("$state_dir/theme/backgrounds")
[[ -n "$theme_name" ]] && search_dirs+=("$config_home/omarchy/backgrounds/$theme_name")
search_dirs+=("$engine_dir")

selected=$(omarchy-menu-images --selected "$current_background" "${search_dirs[@]}")

if [[ -z "$selected" ]]; then
  exit 0
fi

# Obtener lista de monitores
mapfile -t monitors < <(hyprctl monitors -j | jq -r '.[].name')

if [[ ${#monitors[@]} -eq 0 ]]; then
  echo "No monitors found" >&2
  exit 1
fi

# Mostrar selector de monitor
selected_monitor=$(omarchy-menu-select "Select monitor" "${monitors[@]}")

if [[ -z "$selected_monitor" ]]; then
  exit 0
fi

# Aplicar fondo al monitor seleccionado. Se compara el directorio exacto para no
# confundir una ruta que solo contenga "wallpaper-engine" en su nombre.
if [[ "$(dirname -- "$selected")" == "$engine_dir" ]]; then
  WALLPAPER_ID=$(basename "$selected" | sed 's/^wallpaper_//;s/\.[^.]*$//')
  # No se borra el symlink del lockscreen: omarchy-wallpaper-engine lo reemplaza
  # al terminar, y asi un fallo no deja la pantalla de bloqueo sin fondo.
  "$SCRIPT_DIR/set-wallpaper-engine" "$WALLPAPER_ID" "$selected_monitor"
  ENTRY="$selected_monitor:wallpaper-engine:$WALLPAPER_ID"
else
  stop_wallpaper_engine "$selected_monitor"
  omarchy-theme-bg-set "$selected"
  ENTRY="$selected_monitor:static:$selected"
fi

# Guardar asignacion para restaurar al encender. Se filtra con awk comparando el
# primer campo como texto: el nombre del monitor no se interpreta como patron.
mkdir -p -- "$state_dir"
if [[ -f "$CONFIG_FILE" ]]; then
  awk -F: -v m="$selected_monitor" '$1 != m' "$CONFIG_FILE" > "$CONFIG_FILE.tmp"
  mv -- "$CONFIG_FILE.tmp" "$CONFIG_FILE"
fi
echo "$ENTRY" >> "$CONFIG_FILE"
