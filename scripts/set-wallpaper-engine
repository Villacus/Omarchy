#!/bin/bash

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
WALLPAPER_ID="$1"
MONITOR="$2"
LOG_FILE="$HOME/.local/state/omarchy/current/we-debug.log"

# El directorio de estado puede no existir todavia cuando esto corre desde un
# autostart, asi que se crea antes del primer log.
mkdir -p -- "$(dirname -- "$LOG_FILE")"

echo "[$(date)] Recibido: '$WALLPAPER_ID' Monitor: '$MONITOR'" >> "$LOG_FILE"

if [[ -z "$WALLPAPER_ID" ]]; then
  echo "[$(date)] ERROR: No se recibió ID" >> "$LOG_FILE"
  exit 1
fi

echo "[$(date)] Ejecutando wallpaper: $WALLPAPER_ID en monitor: $MONITOR" >> "$LOG_FILE"

# Se propaga el estado del wrapper: antes se registraba "Ejecutado" incluso
# cuando omarchy-wallpaper-engine fallaba.
if "$SCRIPT_DIR/omarchy-wallpaper-engine" "$WALLPAPER_ID" "$MONITOR" >> "$LOG_FILE" 2>&1; then
  echo "[$(date)] Ejecutado" >> "$LOG_FILE"
else
  status=$?
  echo "[$(date)] ERROR: omarchy-wallpaper-engine terminó con $status" >> "$LOG_FILE"
  exit "$status"
fi
